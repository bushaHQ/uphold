{
  "private": true,
  "name": "uphold_payment_widget_sdk_bundler",
  "description": "Bundles the Uphold Payment Widget SDK into a single JS file for the Flutter package.",
  "scripts": {
    "build": "esbuild tool/sdk_entry.js --bundle --format=iife --global-name=UpholdSDK --outfile=assets/payment_widget_sdk.js --minify",
    "build:dev": "esbuild tool/sdk_entry.js --bundle --format=iife --global-name=UpholdSDK --outfile=assets/payment_widget_sdk.js"
  },
  "devDependencies": {
    "@uphold/enterprise-payment-widget-web-sdk": "latest",
    "esbuild": "^0.24.0"
  }
}
